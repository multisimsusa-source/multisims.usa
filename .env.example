# Public site URL (no trailing slash). Production: https://multisimsusa.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Local values come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email (optional in development; messages are logged when unset)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=MultiSims USA <hello@multisimsusa.com>
# Sender for order, delivery, alert and ticket emails
ORDERS_FROM_EMAIL=MultiSims USA <orders@multisimsusa.com>
CONTACT_TO_EMAIL=

# Cloudflare Turnstile on the contact form, order contact and ticket form (optional; skipped when unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Not for Vercel. Secrets for the Supabase Edge Function `unclaimed-alert`, set with
#   supabase secrets set CRON_SECRET=... RESEND_API_KEY=... ORDERS_FROM_EMAIL="..." SITE_URL=https://multisimsusa.com
# (OWNER_EMAIL optional, used when Settings has no owner email). CRON_SECRET must match the
# `cron_secret` Vault secret. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
