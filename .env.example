# Public site URL (no trailing slash). Production: https://multisimsusa.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Local values come from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email (optional in development; messages are logged when unset)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=MultiSims USA <onboarding@resend.dev>
CONTACT_TO_EMAIL=

# Cloudflare Turnstile on the contact form (optional; skipped when unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
